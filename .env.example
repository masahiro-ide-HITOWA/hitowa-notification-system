# Copy to apps/web/.env.local for local development.
# Production (Amplify) must set every required key. Empty values stop the build
# and the production server. Do not commit real secrets.

# Required in production
SESSION_SECRET=
ENCRYPTION_KEY=
COOKIE_DOMAIN=
PORTAL_ORIGIN=
SAML_ENTRY_POINT=
SAML_IDP_ISSUER=
SAML_CERT=
SAML_ISSUER=
SAML_CALLBACK_URL=

# Local development leaves COOKIE_DOMAIN empty (host-only cookie).
# Production example: COOKIE_DOMAIN=.hitowa.com
# Production example: PORTAL_ORIGIN=https://portal.hitowa.com

# Optional. Set after the IdP logout URL is confirmed.
SAML_SLO_URL=

# App URL used for logout redirects when the request host is not enough.
NEXT_PUBLIC_APP_URL=

# LINE. Required to send or reply. The app does not invent a token.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_BOT_BASIC_ID=
LINE_AUTO_DISABLE_ON_BLOCK=

# DynamoDB table names. Defaults exist for local names; set them in AWS.
AWS_REGION=ap-northeast-1
DYNAMODB_TABLE_NAME=HitowaUserMappings
DYNAMODB_USER_TABLE=HitowaUserMappings
DYNAMODB_NOTIFICATION_TABLE=HitowaNotifications
DYNAMODB_MAIL_CONFIG_TABLE=HitowaMailConfigs
DYNAMODB_NOTIFICATION_SYSTEM_TABLE=HitowaNotificationSystems
NOTIFICATION_SYSTEM_CACHE_TTL_MS=300000

# Shared notification inbox (Secrets Manager, with env fallback).
SAAS_MAIL_SECRET_ID=hitowa/notification-portal/saas-mail-credentials
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=
NOTIFICATION_SHARED_INBOX=my-notification@hitowa.com
NOTIFICATION_FALLBACK_PORTAL_USER_ID=

# Legacy webhook key. The old /api/webhook/mail route has been removed.
WEBHOOK_SECRET_KEY=
