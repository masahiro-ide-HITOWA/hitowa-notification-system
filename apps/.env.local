# KAGOYA IMAP接続設定
KAGOYA_IMAP_HOST=mail.kagoya.net
KAGOYA_IMAP_PORT=993
KAGOYA_TEST_USER=yamada.t@hitowa.com
KAGOYA_TEST_PASS=your_kagoya_password

# LINE Messaging API設定
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token
LINE_CHANNEL_SECRET=your_line_channel_secret

# AWS / DynamoDB設定
AWS_REGION=ap-northeast-1
DYNAMODB_USER_TABLE=HitowaUserMappings
PORTAL_BASE_URL=http://localhost:3000

# Webhook 呼び出し認証用の秘密鍵を設定
WEBHOOK_SECRET_KEY=hitowa_secret_key_2026